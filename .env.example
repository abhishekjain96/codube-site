# Codube Website Environment Variables

# Notification recipient email address
CONTACT_NOTIFICATION_EMAIL=admin@codube.io

# SMTP Email Configuration (Optional - for sending live emails on contact form submission)
# If not configured, leads are still safely saved and viewable inside the Admin Panel at /admin
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
